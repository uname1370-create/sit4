datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id               String   @id @default(uuid())
  fullName         String
  phoneNumber      String
  instagramId      String?
  selectedService  String   @default("eyebrows")
  selectedStyle    String
  originalImageUrl String?
  resultImageUrl   String?
  status           String   @default("new") // new, contacted, booked, cancelled
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
