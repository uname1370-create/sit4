# ⚠️ هشدار: الگوی lib/ در .gitignore ریشهٔ ریپو (مخصوص پایتون) هر پوشهٔ lib/ را
# در کل ریپو نادیده می‌گیرد. ماژول‌های بینایی کلاینت در src/lib/vision/ هستند
# و با دو خط زیر عمداً از نادیده‌گرفتن مستثنا شده‌اند تا دوباره گم نشوند:
!src/lib/
!src/lib/**

# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# پوشه‌های build و فایل‌های موقت اسکریپت‌های تست (npm run test:chain / test:admin)
/.next-*/
/.tmp-*

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (کلیدهای API هرگز کامیت نشوند)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
